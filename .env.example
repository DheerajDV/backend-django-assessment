# Local development uses safe local defaults and does not require this file.
# For production, export these values through your host's environment settings.
# The app does not load .env files automatically.
DJANGO_DEBUG=0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=your-app.onrender.com
RUNTIME_DIR=/var/data
# Enable only behind a trusted proxy; Render sets this in render.yaml.
DJANGO_TRUST_PROXY_HEADERS=1
DJANGO_SECURE_SSL_REDIRECT=1
PORT=8000
