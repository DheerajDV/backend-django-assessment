{
  "openapi": "3.0.3",
  "info": {
    "title": "Fuelwise Route & Fuel API",
    "version": "1.0.0",
    "description": "Plan a US driving route and additional fuel purchases. Execute requests to see live server responses; schema models describe the contract only. The vehicle gets 10 mpg and holds 50 gallons. Starting fuel is prepaid and excluded from purchase cost. Results disclose station coverage, provider-call counts, and model limitations."
  },
  "servers": [
    {
      "url": "/",
      "description": "This deployment (same origin)"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Health",
      "description": "Start here to inspect the running Django version and station data."
    },
    {
      "name": "Routes",
      "description": "Create a road and fuel plan, then retrieve its saved response."
    }
  ],
  "paths": {
    "/api/health/": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "getHealth",
        "summary": "Check application and station coverage",
        "description": "Reads the local station catalog. It does not call external mapping services.",
        "responses": {
          "200": {
            "description": "Application status, runtime version, and imported station counts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Not ready: station data or sourced coordinates are missing.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes/": {
      "post": {
        "tags": [
          "Routes"
        ],
        "operationId": "planRoute",
        "summary": "Plan a route and fuel purchases",
        "description": "Geocode the two US endpoints, route between them, select available station candidates, and verify selected fuel stops with a waypoint route. A successful plan is saved and returned with its map URL. Repeat the same request to observe cache behavior. A fresh POST still creates a new saved plan ID.\n\nThe API is public and stateless. No cookie authentication is used. Route POSTs may be rate limited in the hosted demo.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RouteRequest"
              },
              "examples": {
                "longTrip": {
                  "summary": "Long trip — Chicago to Dallas",
                  "description": "Editable input example; execute to obtain actual road distances and purchases.",
                  "value": {
                    "start": "Chicago, IL",
                    "finish": "Dallas, TX",
                    "initial_fuel_gallons": 50
                  }
                },
                "shortTrip": {
                  "summary": "Short trip — Chicago to Milwaukee",
                  "description": "A full prepaid tank usually avoids additional purchases on this short trip. Execute to obtain the actual result.",
                  "value": {
                    "start": "Chicago, IL",
                    "finish": "Milwaukee, WI",
                    "initial_fuel_gallons": 50
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "A newly saved route and verified fuel-purchase plan. Monetary values are decimal strings.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutePlan"
                }
              }
            }
          },
          "400": {
            "description": "Invalid JSON or fields, location not found, or an endpoint outside the United States.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "JSON request body exceeds the configured size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "415": {
            "description": "Send Content-Type: application/json.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "No drivable route, insufficient station coverage, or an infeasible verified fuel itinerary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "The hosted demo request limit was reached. Retry after the indicated delay.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "Retry-After": {
                "description": "Seconds until another request may be accepted.",
                "schema": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          },
          "502": {
            "description": "Routing/geocoding provider is unavailable or returned an invalid response.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The station dataset has not been imported.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/routes/{id}/": {
      "get": {
        "tags": [
          "Routes"
        ],
        "operationId": "getRoute",
        "summary": "Retrieve a saved route plan",
        "description": "Paste an id returned by a successful POST. Returns its stored result without calling external providers. Metadata records the original planning request, not this retrieval.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID returned by POST /api/routes/.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The persisted route plan.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoutePlan"
                }
              }
            }
          },
          "404": {
            "description": "No saved route has this UUID. A malformed UUID fails URL matching and may return an HTML 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "RouteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "finish"
        ],
        "properties": {
          "start": {
            "type": "string",
            "description": "A United States city and state, or street address. Length is checked after trimming whitespace.",
            "minLength": 2,
            "maxLength": 200
          },
          "finish": {
            "type": "string",
            "description": "A United States city and state, or street address. Length is checked after trimming whitespace.",
            "minLength": 2,
            "maxLength": 200
          },
          "initial_fuel_gallons": {
            "type": "number",
            "description": "Fuel already in the tank and already paid for. Omit for a full tank. Zero is valid input but can make the journey infeasible.",
            "minimum": 0,
            "maximum": 50,
            "default": 50
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "django_version",
          "total_stations",
          "located_stations"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "ok means station data is imported; this is not a live probe of upstream routing/geocoding.",
            "enum": [
              "ok",
              "needs_data"
            ]
          },
          "django_version": {
            "type": "string",
            "description": "Installed Django version reported at runtime."
          },
          "total_stations": {
            "type": "integer",
            "description": "Imported, deduplicated US stations.",
            "minimum": 0
          },
          "located_stations": {
            "type": "integer",
            "description": "Stations with both latitude and longitude; unlocated stations are excluded from route candidates.",
            "minimum": 0
          }
        }
      },
      "Location": {
        "type": "object",
        "required": [
          "name",
          "latitude",
          "longitude"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Location label returned by the geocoder."
          },
          "latitude": {
            "type": "number",
            "description": "Latitude in decimal degrees.",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "description": "Longitude in decimal degrees.",
            "minimum": -180,
            "maximum": 180
          }
        }
      },
      "Money": {
        "type": "string",
        "description": "Nonnegative USD amount encoded as a decimal string, rounded to cents using ROUND_HALF_UP.",
        "pattern": "^\\d+\\.\\d{2}$"
      },
      "Price": {
        "type": "string",
        "description": "USD per US gallon from the imported price snapshot, encoded as a decimal string.",
        "pattern": "^\\d+(\\.\\d+)?$"
      },
      "Geometry": {
        "type": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "LineString"
            ]
          },
          "coordinates": {
            "type": "array",
            "minItems": 2,
            "description": "GeoJSON positions in longitude, latitude order, following the selected driving route.",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      },
      "RoadRoute": {
        "type": "object",
        "required": [
          "distance_miles",
          "duration_hours",
          "geometry"
        ],
        "properties": {
          "distance_miles": {
            "type": "number",
            "description": "Driving distance including selected station waypoints.",
            "minimum": 0
          },
          "duration_hours": {
            "type": "number",
            "description": "Routing-provider driving duration; excludes fueling and other stop time.",
            "minimum": 0
          },
          "geometry": {
            "$ref": "#/components/schemas/Geometry"
          }
        }
      },
      "FuelStop": {
        "type": "object",
        "required": [
          "station_id",
          "mile",
          "gallons",
          "price_per_gallon",
          "cost",
          "arrival_fuel_gallons",
          "departure_fuel_gallons",
          "name",
          "address",
          "city",
          "state",
          "latitude",
          "longitude",
          "coordinate_source",
          "offset_miles"
        ],
        "properties": {
          "station_id": {
            "type": "integer",
            "description": "Imported OPIS station identifier."
          },
          "mile": {
            "type": "number",
            "description": "Cumulative road miles from the start on the verified itinerary.",
            "minimum": 0
          },
          "gallons": {
            "type": "number",
            "description": "US gallons purchased at this stop.",
            "minimum": 0,
            "maximum": 50
          },
          "price_per_gallon": {
            "$ref": "#/components/schemas/Price"
          },
          "cost": {
            "$ref": "#/components/schemas/Money"
          },
          "arrival_fuel_gallons": {
            "type": "number",
            "description": "Fuel in the tank on arrival.",
            "minimum": 0,
            "maximum": 50
          },
          "departure_fuel_gallons": {
            "type": "number",
            "description": "Fuel in the tank after this purchase.",
            "minimum": 0,
            "maximum": 50
          },
          "name": {
            "type": "string",
            "description": "Imported station name."
          },
          "address": {
            "type": "string",
            "description": "Imported station address."
          },
          "city": {
            "type": "string",
            "description": "Imported station city."
          },
          "state": {
            "type": "string",
            "description": "Imported station state."
          },
          "latitude": {
            "type": "number",
            "description": "Sourced station latitude.",
            "minimum": -90,
            "maximum": 90
          },
          "longitude": {
            "type": "number",
            "description": "Sourced station longitude.",
            "minimum": -180,
            "maximum": 180
          },
          "coordinate_source": {
            "type": "string",
            "description": "Source used to obtain these station coordinates."
          },
          "offset_miles": {
            "type": "number",
            "description": "Approximate perpendicular distance from the initial route; this is not a road detour distance.",
            "minimum": 0
          }
        }
      },
      "FuelPlan": {
        "type": "object",
        "required": [
          "stops",
          "total_fuel_cost",
          "fuel_purchased_gallons",
          "fuel_consumed_gallons",
          "initial_fuel_gallons",
          "remaining_fuel_gallons"
        ],
        "properties": {
          "stops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FuelStop"
            },
            "description": "Ordered stops where a positive purchase is made; can be empty."
          },
          "total_fuel_cost": {
            "$ref": "#/components/schemas/Money"
          },
          "fuel_purchased_gallons": {
            "type": "number",
            "description": "Total additional fuel purchased during the journey.",
            "minimum": 0
          },
          "fuel_consumed_gallons": {
            "type": "number",
            "description": "Driving distance divided by the assumed 10 mpg.",
            "minimum": 0
          },
          "initial_fuel_gallons": {
            "type": "number",
            "description": "Prepaid starting fuel, excluded from total_fuel_cost.",
            "minimum": 0,
            "maximum": 50
          },
          "remaining_fuel_gallons": {
            "type": "number",
            "description": "Fuel left on arrival at the destination.",
            "minimum": 0,
            "maximum": 50
          }
        },
        "description": "Purchase costs are calculated with Decimal. Each stop is rounded to cents; the total is rounded once from unrounded costs, so displayed stop costs can differ from the total by rounding cents."
      },
      "Metadata": {
        "type": "object",
        "required": [
          "routing_api_calls",
          "geocoding_api_calls",
          "elapsed_ms",
          "candidate_stations",
          "located_stations",
          "total_stations",
          "routed_station_waypoints",
          "assumptions",
          "warnings",
          "attribution"
        ],
        "properties": {
          "routing_api_calls": {
            "type": "integer",
            "description": "Actual OSRM HTTP attempts made to construct this plan. Normally one base route and, when stops are selected, a second route through the stops; cache hits make no upstream call.",
            "minimum": 0
          },
          "geocoding_api_calls": {
            "type": "integer",
            "description": "Actual Photon HTTP attempts for the start and finish. Reported separately from routing calls; cached locations need no call.",
            "minimum": 0
          },
          "elapsed_ms": {
            "type": "number",
            "description": "Plan construction time measured on the server, before saving the route record and serializing the HTTP response.",
            "minimum": 0
          },
          "candidate_stations": {
            "type": "integer",
            "description": "Stations considered near the initial driving route.",
            "minimum": 0
          },
          "located_stations": {
            "type": "integer",
            "description": "Imported stations with sourced coordinates.",
            "minimum": 0
          },
          "total_stations": {
            "type": "integer",
            "description": "Total imported, deduplicated US stations.",
            "minimum": 0
          },
          "routed_station_waypoints": {
            "type": "integer",
            "description": "Selected station waypoints included in the verified road route; some may no longer require a purchase after recalculation.",
            "minimum": 0
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Vehicle, price, routing, cost, and optimization assumptions for this plan."
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Coverage and optimization limitations; read before interpreting the fuel cost."
          },
          "attribution": {
            "type": "string",
            "description": "Routing, map-data, and geocoding attribution."
          }
        }
      },
      "RoutePlan": {
        "type": "object",
        "required": [
          "id",
          "map_url",
          "start",
          "finish",
          "route",
          "fuel_plan",
          "metadata"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "ID of the saved plan."
          },
          "map_url": {
            "type": "string",
            "format": "uri",
            "description": "Absolute URL of this plan’s interactive road map on the current deployment."
          },
          "start": {
            "$ref": "#/components/schemas/Location"
          },
          "finish": {
            "$ref": "#/components/schemas/Location"
          },
          "route": {
            "$ref": "#/components/schemas/RoadRoute"
          },
          "fuel_plan": {
            "$ref": "#/components/schemas/FuelPlan"
          },
          "metadata": {
            "$ref": "#/components/schemas/Metadata"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Machine-readable error code, such as invalid_request, outside_usa, insufficient_station_coverage, upstream_unavailable, or rate_limited."
              },
              "message": {
                "type": "string",
                "description": "Human-readable explanation."
              },
              "details": {
                "type": "object",
                "additionalProperties": true,
                "description": "Optional context, such as coverage counts or an unreachable-segment reason."
              }
            }
          }
        }
      }
    }
  }
}
